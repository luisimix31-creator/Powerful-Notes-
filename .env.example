# Copy this file to .env and fill in real values. Never commit .env.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local dev default is fine as-is. In production, point this at a managed
# Postgres instance or a persistent volume for SQLite.
DATABASE_URL=sqlite:///app.db

# Set to "true" once served over HTTPS (required for secure cookies in prod).
SESSION_COOKIE_SECURE=false

# Local dev only: enables Flask's interactive debugger. Never set this in
# production - it allows arbitrary code execution from the browser on errors.
FLASK_DEBUG=false

# Password reset emails, sent via Resend (https://resend.com). Without an API
# key, "Forgot password" requests are logged but no email is actually sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional: shown on the "Forgot password" page for users who don't remember
# which email they signed up with.
SUPPORT_EMAIL=

# Stripe billing (https://dashboard.stripe.com). STRIPE_PRICE_ID is the Price
# ID of the $5.99/month subscription Product. STRIPE_WEBHOOK_SECRET comes from
# the webhook endpoint you create in the Stripe dashboard pointing at
# /webhooks/stripe. Without these set, the paywall page renders but checkout
# will fail. If you end up with more than one event destination in Stripe (each
# has its own signing secret), the extra secrets can go in
# STRIPE_WEBHOOK_SECRET_2/_3/_4 - the app tries each one.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_2=
STRIPE_WEBHOOK_SECRET_3=
STRIPE_WEBHOOK_SECRET_4=

# Your own login email. Accounts matching this address always bypass the
# paywall, so you keep access to your own clients/notes without subscribing.
OWNER_EMAIL=

# Anthropic API key (https://console.anthropic.com), used only by the
# "extract from document" buttons on the New Client form to read an uploaded
# Initial Assessment / Reassessment (PDF or Word) and pre-fill the client
# profile. Without this set, those buttons return an error and every other
# feature works normally.
ANTHROPIC_API_KEY=
