{
  "name": "powerful-notes-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Powerful Notes - native Mac/Windows desktop wrapper",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.powerfulnotes.app",
    "productName": "Powerful Notes",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "icons/**/*"],
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "mac": {
      "icon": "icons/icon.icns",
      "category": "public.app-category.medical",
      "target": ["dmg"]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
